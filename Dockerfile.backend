# Production Dockerfile for Python FastAPI Backend Service
FROM python:3.11-slim

WORKDIR /app

# Install system libraries for OpenCV and NetCDF
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements & install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir opencv-python-headless pillow

# Copy application source code
COPY . .

# Pre-train baseline model artifacts
RUN python ml/train_genesis.py

EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
